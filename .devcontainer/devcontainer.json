{
	"name": "HEIG-VD ProgServ1 Course Development Container",
	"image": "mcr.microsoft.com/devcontainers/php:8.5-trixie",
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"moby": false
		}
	},
	"customizations": {
		"vscode": {
			"extensions": ["esbenp.prettier-vscode", "qwtel.sqlite-viewer"]
		}
	},
	// Ports to expose on the container's network host
	"forwardPorts": [8080],
	"portsAttributes": {
		"8080": {
			"label": "Apache HTTP Server"
		}
	}
}
