{
	"name": "HEIG-VD ProgServ1 Course Development Container",
	"image": "mcr.microsoft.com/devcontainers/base:trixie",
	"workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
	"workspaceFolder": "/workspace",
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {
			"moby": false
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"bmewburn.vscode-intelephense-client",
				"cweijan.vscode-database-client2",
				"esbenp.prettier-vscode",
				"qwtel.sqlite-viewer"
			]
		}
	},
	// Ports to expose on the container's network host
	"forwardPorts": [8080],
	"portsAttributes": {
		"8080": {
			"label": "Apache HTTP Server"
		}
	},
	// Execute the following command once the container is created
	"postCreateCommand": ".devcontainer/post-create.sh"
}
