{
	"name": "HEIG-VD ProgServ1 Course Development Container",
	"image": "mcr.microsoft.com/devcontainers/php:8.5-trixie",
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"moby": false
		}
	},
	"customizations": {
		"vscode": {
			"extensions": ["esbenp.prettier-vscode", "qwtel.sqlite-viewer"]
		}
	},
	// Map the user's SSH directory to the container for SSH signing
	"mounts": [
		"type=bind,source=${localEnv:HOME}/.ssh,target=${localEnv:HOME}/.ssh,type=bind,consistency=cached"
	],
	// Ports to expose on the container's network host
	"forwardPorts": [8080],
	"portsAttributes": {
		"8080": {
			"label": "Apache HTTP Server"
		}
	}
}
